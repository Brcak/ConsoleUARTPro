<Window x:Class="ConsoleUARTPro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Console UART Pro" Width="960" Height="650" Background="#151923" Foreground="White"><DockPanel Margin="16"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Console UART Pro" FontSize="25" FontWeight="Bold" Margin="0,0,0,12"/><WrapPanel Margin="0,0,0,12"><ComboBox x:Name="Ports" Width="150" Margin="0,0,8,0"/><Button Content="Refresh ports" Click="Refresh_Click" Padding="10,6" Margin="0,0,8,0"/><ComboBox x:Name="Bauds" Width="110" SelectedIndex="1" Margin="0,0,8,0"><ComboBoxItem Content="9600"/><ComboBoxItem Content="115200"/><ComboBoxItem Content="57600"/><ComboBoxItem Content="38400"/></ComboBox><Button Content="Connect RX" Click="Connect_Click" Padding="10,6" Margin="0,0,8,0"/><Button Content="Disconnect" Click="Disconnect_Click" Padding="10,6" Margin="0,0,8,0"/><Button Content="Save log" Click="Save_Click" Padding="10,6"/></WrapPanel><TextBlock x:Name="Status" Text="Disconnected — RX only; verify signal voltage and pinout before connecting." TextWrapping="Wrap" Margin="0,0,0,12"/></StackPanel><TabControl><TabItem Header="UART Terminal"><TextBox x:Name="Log" Background="#0D1118" Foreground="#B8F0C5" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/></TabItem><TabItem Header="Updates &amp; Components"><ScrollViewer><StackPanel Margin="15"><TextBlock Text="Update preference" FontSize="18" Margin="0,0,0,8"/><ComboBox x:Name="UpdateMode" SelectedIndex="1" Width="240" HorizontalAlignment="Left"><ComboBoxItem Content="Off"/><ComboBoxItem Content="Notify only"/><ComboBoxItem Content="Ask before downloading"/></ComboBox><TextBlock Text="Select optional packages for future releases. This version saves preferences only; it does not download or install modules." TextWrapping="Wrap" Margin="0,12,0,12"/><CheckBox Content="Core UART application (required)" IsChecked="True" IsEnabled="False"/><CheckBox x:Name="Database" Content="Offline error-code database" Margin="0,8,0,0"/><CheckBox x:Name="Pico" Content="Pico / Pico 2 firmware" Margin="0,8,0,0"/><CheckBox x:Name="Esp" Content="ESP32-S3 firmware" Margin="0,8,0,0"/><CheckBox x:Name="Pi" Content="Raspberry Pi Zero bridge" Margin="0,8,0,0"/><CheckBox x:Name="Boardview" Content="Interactive boardview packs" Margin="0,8,0,0"/><CheckBox x:Name="Thermal" Content="Thermal camera integration" Margin="0,8,0,0"/><CheckBox x:Name="Logic" Content="Logic analyzer integration" Margin="0,8,0,0"/><Button Content="Save preferences" Click="Save_ClickPrefs" Width="160" HorizontalAlignment="Left" Margin="0,15,0,0"/><TextBlock x:Name="PrefsStatus" Margin="0,8,0,0"/></StackPanel></ScrollViewer></TabItem></TabControl></DockPanel></Window>